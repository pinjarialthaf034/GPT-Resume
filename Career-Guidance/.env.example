# ============================================================
# CareerCompass AI — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Google Gemini (Single or Multiple Keys with Automatic Failover/Rotation) ---
# Primary key (backward compatible):
GEMINI_API_KEY=your-primary-gemini-api-key
# Scalable fallback keys:
# GEMINI_API_KEY_1=your-first-gemini-api-key
# GEMINI_API_KEY_2=your-second-gemini-api-key
# GEMINI_API_KEY_3=your-third-gemini-api-key
# Or comma-separated:
# GEMINI_API_KEYS=key1,key2,key3
# Change the model without touching code (gemini-3.5-flash, gemini-3.6-flash, etc.)
GEMINI_MODEL=gemini-3.5-flash

# --- App Settings ---
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret
# Comma-separated origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://localhost:8000,https://gpt-career.netlify.app

# --- AI Rate-Limit Controls (per user per hour) ---
AI_CAREER_ANALYSIS_RATE_LIMIT=3
AI_RESUME_ANALYSIS_RATE_LIMIT=5
AI_CHAT_RATE_LIMIT=30
# Max tokens to include from conversation history in chatbot context
CHAT_MAX_CONTEXT_TOKENS=2000

# --- Resume Upload ---
MAX_RESUME_SIZE_MB=5

# --- Logging ---
LOG_LEVEL=INFO
